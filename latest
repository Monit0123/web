+.schedule-head span{font:9px 'DM Mono';letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
+.schedule-row{border-top:1px solid var(--line)}
+.schedule-row span{padding:16px 10px 16px 0;line-height:1.45;color:#e6eae4}
+.schedule-time{font:10px 'DM Mono';letter-spacing:.08em;color:var(--muted)}
+.schedule-row span[data-c=s]{color:var(--lime)}
+.schedule-row span[data-c=c]{color:#8fd6ff}
+.schedule-row span[data-c=r]{color:#ffc9a3}
+.schedule-row span[data-c=o]{color:var(--muted)}
+.schedule-legend{display:flex;flex-wrap:wrap;gap:22px;margin-top:26px;font:9px 'DM Mono';letter-spacing:.12em;text-transform:uppercase}
+.schedule-legend span{display:flex;align-items:center;gap:8px;color:var(--muted)}
+.schedule-legend span:before{content:'';width:9px;height:9px;border-radius:50%;background:currentColor}
+.schedule-legend span[data-c=s]{color:var(--lime)}
+.schedule-legend span[data-c=c]{color:#8fd6ff}
+.schedule-legend span[data-c=r]{color:#ffc9a3}
+.schedule-cta{display:flex;justify-content:space-between;align-items:center;gap:34px;flex-wrap:wrap;margin-top:52px;padding-top:30px;border-top:1px solid var(--line)}
+.schedule-cta p{font:10px 'DM Mono';letter-spacing:.09em;line-height:2;color:var(--muted);max-width:52ch;margin:0}
+@media(max-width:900px){
+.schedule-grid{overflow-x:auto;-webkit-overflow-scrolling:touch}
+.schedule-head,.schedule-row{grid-template-columns:70px repeat(6,minmax(112px,1fr));min-width:740px}
+.schedule-cta{flex-direction:column;align-items:flex-start}
+.schedule-cta .solid-button{width:100%}
+}
+
+/* ---------------------------------------------------------------------------
+   FAQ
+   --------------------------------------------------------------------------- */
+.faq h2{font-size:clamp(3rem,5.4vw,5.6rem);margin:0 0 56px}
+.faq-list{border-top:1px solid var(--line)}
+.faq details{border-bottom:1px solid var(--line)}
+.faq summary{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:26px 0;font-size:19px;letter-spacing:-.02em;cursor:pointer;list-style:none;transition:color .2s}
+.faq summary::-webkit-details-marker{display:none}
+.faq summary:hover{color:var(--lime)}
+.faq summary span{position:relative;flex:0 0 22px;height:22px}
+.faq summary span:before,.faq summary span:after{content:'';position:absolute;top:50%;left:0;width:22px;height:1.5px;background:currentColor;transition:transform .25s ease}
+.faq summary span:after{transform:rotate(90deg)}
+.faq details[open] summary{color:var(--lime)}
+.faq details[open] summary span:after{transform:rotate(0)}
+.faq details p{font-size:14px;line-height:1.85;color:var(--muted);max-width:70ch;margin:0 0 28px}
+.faq details p a{color:var(--lime)}
+@media(max-width:720px){.faq summary{font-size:16px;padding:22px 0}}
+
+/* Fifth mobile-menu item (Schedule) needs its own stagger step */
+.mobile-menu.is-open nav a:nth-child(5){animation-delay:280ms}
+/* Directions link in the visit band */
+.visit-map{display:inline-block;margin-top:10px;font:9px 'DM Mono';letter-spacing:.12em;text-transform:uppercase;color:var(--lime)!important;border-color:var(--lime)!important}
