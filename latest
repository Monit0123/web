+const legacyHash = async password => {
+  if (window.crypto && crypto.subtle) {
+    return toHex(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(password)));
+  }
+  return btoa(unescape(encodeURIComponent(password)));
