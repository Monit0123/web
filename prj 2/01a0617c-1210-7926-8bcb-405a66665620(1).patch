+.price .confused-cta{margin-top:26px;color:#43524b;align-self:flex-start}
+.reach-fab{--tile-fill:#0b2020;position:fixed;right:26px;bottom:26px;z-index:8;display:inline-flex;align-items:center;justify-content:space-between;gap:14px;height:54px;padding:6px 8px 6px 22px;border:0;border-radius:999px;background:var(--lime);color:var(--ink);font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;box-shadow:0 14px 40px rgba(0,0,0,.45);transition:transform .25s cubic-bezier(.16,1,.3,1)}
+.reach-fab:hover{transform:translateY(-3px)}
+.reach-fab .arrow-icon{width:38px;height:38px;border:2px solid currentColor;border-radius:50%;flex:0 0 38px}
+@media(max-width:720px){.contact-dialog{padding:34px 22px 28px}.contact-submit{width:100%}.reach-fab{right:18px;bottom:18px}}
+
+/* Duration-based plans (overrides 3-column grid) */
+.plans-dialog{width:min(1120px,94vw)}
+.plans-note{font:10px 'DM Mono';letter-spacing:.1em;color:var(--muted);margin:-14px 0 30px;max-width:620px;line-height:1.8}
+.plans-grid{grid-template-columns:repeat(4,1fr)}
+@media(max-width:1020px){.plans-grid{grid-template-columns:repeat(2,1fr)}.plans-dialog{padding:44px 30px}}
+@media(max-width:720px){.plans-grid{grid-template-columns:1fr}.plans-dialog{padding:34px 20px 26px}}
+
+/* Respect reduced-motion preferences */
+@media (prefers-reduced-motion: reduce){
+html{scroll-behavior:auto}
+*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
+}
+
+/* Visit / contact band + footer support button */
+.visit{background:#0d2e2d}
+.visit .eyebrow{color:var(--muted)}
+.visit-title{font-size:clamp(3.2rem,5.6vw,6.2rem);margin:0 0 66px}
+.visit-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}
+.visit-grid div{padding:26px 24px 0 0;border-right:1px solid var(--line)}
+.visit-grid div+div{padding-left:24px}
+.visit-grid div:last-child{border:0}
+.visit-grid span{font:10px 'DM Mono';letter-spacing:.12em;color:var(--lime)}
+.visit-grid p{font-size:15px;line-height:1.7;margin:16px 0 0;color:#e6eae4}
+.visit-grid p a{color:inherit;text-decoration:none;border-bottom:1px solid rgba(232,229,220,.4);padding-bottom:2px;transition:color .2s,border-color .2s}
+.visit-grid p a:hover{color:var(--lime);border-color:var(--lime)}
+footer .footer-support{background:none;border:0;color:inherit;font-family:Manrope,Arial,sans-serif;font-size:11px;text-transform:uppercase;letter-spacing:.1em;cursor:pointer;padding:8px 0}
+@media(max-width:720px){.visit-grid{grid-template-columns:1fr 1fr}.visit-grid div:nth-child(2){border-right:0}.visit-grid div:nth-child(n+3){border-top:1px solid var(--line);padding-top:24px;margin-top:24px}}
+
+/* Auth + onboarding dialogs */
+.auth-dialog,.onboard-dialog{position:fixed;inset:0;margin:auto;width:min(560px,94vw);max-height:min(90vh,880px);overflow-y:auto;padding:52px;background:#0a1d1c;color:var(--paper);border:1px solid var(--line);box-shadow:0 60px 120px rgba(0,0,0,.55)}
+.onboard-dialog{width:min(680px,94vw)}
+.auth-dialog::backdrop,.onboard-dialog::backdrop{background:rgba(3,10,10,.78);backdrop-filter:blur(8px)}
+.auth-dialog button,.auth-dialog input,.onboard-dialog button,.onboard-dialog input{font-family:inherit;cursor:pointer}
+.auth-dialog .eyebrow,.onboard-dialog .eyebrow{color:var(--muted);margin-bottom:18px}
+.auth-dialog h2,.onboard-dialog h2{font-size:clamp(2.6rem,5vw,4.4rem);margin:0 0 20px}
+.auth-tabs{display:flex;gap:0;margin:34px 0 30px;border-bottom:1px solid var(--line)}
+.auth-tab{background:none;border:0;border-bottom:2px solid transparent;padding:12px 4px;margin-right:28px;color:var(--muted);font:11px 'DM Mono';letter-spacing:.12em;text-transform:uppercase;transition:color .2s,border-color .2s}
+.auth-tab.is-active{color:var(--lime);border-color:var(--lime)}
+.auth-note{font:11px 'DM Mono';letter-spacing:.06em;line-height:1.7;color:var(--lime);background:rgba(215,255,50,.08);border:1px solid rgba(215,255,50,.3);padding:12px 14px;margin:0 0 26px}
+.auth-form{display:flex;flex-direction:column;gap:24px}
+.auth-submit{margin-top:6px;width:100%;height:58px;border:0;border-radius:999px;background:var(--lime);color:var(--ink);font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;transition:transform .2s,opacity .2s}
+.auth-submit:hover{transform:translateY(-2px)}
+.auth-text-btn{background:none;border:0;border-bottom:1px solid rgba(232,229,220,.5);padding:0 0 5px;color:var(--paper);font:10px 'DM Mono';letter-spacing:.12em;text-transform:uppercase;align-self:center;margin-top:2px;transition:color .2s}
+.auth-text-btn:hover{color:var(--lime)}
+.ob-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px 24px}
+.ob-group{margin-top:22px}
+.ob-group>.field-label{display:block;margin-bottom:12px}
+.ob-chips{display:flex;flex-wrap:wrap;gap:8px}
+.ob-chips button{background:transparent;border:1px solid rgba(232,229,220,.3);border-radius:999px;color:var(--paper);font-size:11px;letter-spacing:.06em;padding:11px 16px;transition:background .2s,color .2s,border-color .2s}
+.ob-chips button:hover{border-color:var(--lime);color:var(--lime)}
+.ob-chips button.is-on{background:var(--lime);border-color:var(--lime);color:var(--ink);font-weight:700}
+.ob-form .auth-submit{margin-top:30px}
+
+/* Profile page */
+.profile-gate{min-height:78vh;display:flex;flex-direction:column;align-items:flex-start;justify-content:center}
+.profile-gate h1{margin-bottom:26px}
+.profile-gate .about-hero-desc{margin-bottom:42px}
+.pf-stats{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);margin-top:64px;padding-top:4px}
+.pf-stats div{border-right:1px solid var(--line);padding:24px 22px 0 0}
+.pf-stats div+div{padding-left:22px}
+.pf-stats div:last-child{border:0}
+.pf-stats strong{font-size:clamp(1.5rem,2.6vw,2.6rem);letter-spacing:-.05em;line-height:1.1;display:block}
+.pf-stats span{font:9px 'DM Mono';letter-spacing:.12em;text-transform:uppercase;color:var(--muted);display:block;margin-top:12px}
+.pf-actions{display:flex;align-items:center;gap:26px;margin-top:56px;flex-wrap:wrap}
+.profile-page .plan-join{cursor:pointer}
+.pf-ghost-link{text-decoration:none}
+.pf-empty h2,.pf-training h2,.pf-diet h2{font-size:clamp(3rem,5.4vw,5.6rem);margin:0 0 34px}
+.pf-empty .about-hero-desc{margin-bottom:40px}
+.pf-training{background:#0b2422}
+.pf-training .eyebrow{color:var(--lime)}
+.pf-note{font:10px 'DM Mono';letter-spacing:.1em;line-height:1.9;color:var(--lime);margin:-14px 0 30px;max-width:640px}
+.pf-days{border-top:1px solid var(--line)}
+.pf-day{border-bottom:1px solid var(--line);padding:22px 0}
+.pf-day-head{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:12px}
+.pf-day-head h4{font-size:17px;letter-spacing:-.02em;margin:0}
+.pf-day-head span{font:10px 'DM Mono';letter-spacing:.12em;color:var(--muted)}
+.pf-day ul{list-style:none;padding:0;margin:0;font-size:12px;line-height:2.1;color:var(--muted)}
+.pf-day li:before{content:'—';padding-right:10px}
+.pf-diet{background:#e9e5dc;color:var(--ink)}
+.pf-diet .eyebrow{color:#54635d}
+.pf-macro{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #9da69e;margin-bottom:56px}
+.pf-macro div{padding:26px 22px 0 0;border-right:1px solid #9da69e}
+.pf-macro div+div{padding-left:22px}
+.pf-macro div:last-child{border:0}
+.pf-macro strong{font-size:clamp(2.2rem,4.2vw,4rem);letter-spacing:-.08em;line-height:1;display:block}
+.pf-macro span{font:9px 'DM Mono';letter-spacing:.12em;color:#54635d;display:block;margin-top:12px}
+.pf-meals{display:grid;grid-template-columns:1fr 1fr;gap:14px}
+.pf-meal{border-top:1px solid #9da69e;padding:20px 0 6px}
+.pf-meal h4{font-size:13px;text-transform:uppercase;letter-spacing:.1em;margin:0 0 12px;font-weight:700}
+.pf-meal p{font-size:13px;line-height:1.75;color:#43524b;margin:0}
+.pf-diet-note{font:9px 'DM Mono';letter-spacing:.1em;line-height:1.9;color:#6a7a70;margin:44px 0 0}
+@media(max-width:720px){.auth-dialog,.onboard-dialog{padding:32px 20px 26px}.ob-grid{grid-template-columns:1fr 1fr;gap:16px 14px}.pf-stats{grid-template-columns:1fr 1fr}.pf-stats div:nth-child(2){border-right:0}.pf-stats div:nth-child(n+3){border-top:1px solid var(--line);padding-top:20px;margin-top:20px}.pf-macro{grid-template-columns:1fr}.pf-macro div{border-right:0;border-top:1px solid #9da69e}.pf-macro div:first-child{border-top:0}.pf-meals{grid-template-columns:1fr}}
+
+/* hidden must always win over component display rules */
+[hidden]{display:none!important}
+
+/* Skip link: hidden until focused */
+.skip-link{position:absolute;left:14px;top:-70px;z-index:60;background:var(--lime);color:var(--ink);padding:13px 18px;font:700 11px Manrope,Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;transition:top .2s ease}
+.skip-link:focus-visible{top:14px;left:14px}
+
+/* Legal page */
+.legal-body{background:#e9e5dc;color:var(--ink)}
+.legal-terms{border-top:1px solid #9da69e}
+.legal-kicker{font:10px 'DM Mono';letter-spacing:.14em;text-transform:uppercase;color:#54635d;margin:0 0 34px}
+.legal-block{border-top:1px solid #9da69e;padding:30px 0;display:grid;grid-template-columns:1fr 1.6fr;gap:6vw}
+.legal-block:last-child{border-bottom:0}
+.legal-block h3{font-size:24px;letter-spacing:-.04em;line-height:1.1;margin:0}
+.legal-block p{font-size:14px;line-height:1.8;color:#3d4a44;max-width:620px;margin:0 0 14px}
+.legal-block p:last-child{margin:0}
+@media(max-width:720px){.legal-block{grid-template-columns:1fr;gap:14px}}
+
+/* FAB clears the footer while it's on screen */
+.reach-fab{transition:transform .35s cubic-bezier(.22,1,.36,1),opacity .35s,visibility 0s linear 0s}
+.reach-fab.fab-clear{transform:translateY(24px) scale(.92);opacity:0;visibility:hidden;pointer-events:none;transition:transform .35s cubic-bezier(.22,1,.36,1),opacity .35s,visibility 0s linear .35s}
